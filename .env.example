# ==============================================================================
# SIMS — Sales Intelligence and Management System
# Production-Ready Multi-Tenant Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for your local or production environment.
# Never commit real credentials, private keys, or secrets to source control.

# Application Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME="SIMS — Sales Intelligence and Management System"
DEBUG=true

# Backend API Host and Port
API_HOST=127.0.0.1
API_PORT=8000
API_V1_STR=/api/v1

# Security & Authentication (JWT & Password Hashing)
# Generate a cryptographically secure key in production: openssl rand -hex 32
SECRET_KEY=sims-super-secret-development-key-change-in-production-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo Environment Credentials Configuration (Section 18 Specification)
# Configures the shared demo password for the six company demo accounts and superadmin
DEMO_PASSWORD=Demo12345!

# MongoDB Database Engine Configuration
# Target MongoDB connection string (standalone, replica set, or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sims_dev

# When true, automatically falls back to in-memory mongomock with pre-seeded demo data
# if a live mongod instance is not listening on MONGODB_URI. Set to false for persistent MongoDB.
USE_MOCK_MONGO=false

# File Upload Limits (Bytes) - Default: 15MB
MAX_UPLOAD_SIZE_BYTES=15728640

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Frontend Environment Variables (mirrored in frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
